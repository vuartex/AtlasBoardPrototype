  - key: rent.bankrupt.title
    en: BANKRUPT
    tr: "\u0130FLAS"
    es: BANCARROTA
    fr: FAILLITE
    de: INSOLVENT
    ko: "\uD30C\uC0B0"
    ru: "\u0411\u0410\u041D\u041A\u0420\u041E\u0422"
  - key: rent.bankrupt.description
    en: "{0} could not pay the {2} \u20B5 rent required for {1}. Remaining cash and
      properties were transferred to {3}."
    tr: "{0}, {1} i\xE7in gereken {2} \u20B5 kiray\u0131 \xF6deyemedi. Kalan nakit
      ve m\xFClkler {3} hesab\u0131na aktar\u0131ld\u0131."
    es: "{0} no pudo pagar el alquiler de {2} \u20B5 requerido por {1}. El dinero
      y las propiedades restantes se transfirieron a {3}."
    fr: "{0} n'a pas pu payer le loyer de {2} \u20B5 pour {1}. L'argent et les propri\xE9t\xE9s
      restants ont \xE9t\xE9 transf\xE9r\xE9s \xE0 {3}."
    de: "{0} konnte die f\xFCr {1} f\xE4llige Miete von {2} \u20B5 nicht bezahlen.
      Verbleibendes Geld und Grundst\xFCcke wurden an {3} \xFCbertragen."
    ko: "{0}\uB2D8\uC774 {1}\uC758 \uC784\uB300\uB8CC {2} \u20B5\uB97C \uC9C0\uBD88\uD558\uC9C0
      \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uB0A8\uC740 \uD604\uAE08\uACFC \uBD80\uB3D9\uC0B0\uC740
      {3}\uC5D0\uAC8C \uC774\uC804\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    ru: "{0} \u043D\u0435 \u0441\u043C\u043E\u0433 \u043E\u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u0430\u0440\u0435\u043D\u0434\u0443 {2} \u20B5 \u0437\u0430 {1}. \u041E\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044F
      \u0434\u0435\u043D\u044C\u0433\u0438 \u0438 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      \u043F\u0435\u0440\u0435\u0434\u0430\u043D\u044B {3}."
