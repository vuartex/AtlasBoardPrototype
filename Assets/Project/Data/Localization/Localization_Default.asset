    tr: "Seyahat \xFCcreti: \xDCcretsiz"
    es: 'Coste del viaje: Gratis'
    fr: "Co\xFBt du voyage : Gratuit"
    de: 'Reisekosten: Kostenlos'
    ko: "\uC5EC\uD589 \uBE44\uC6A9: \uBB34\uB8CC"
    ru: "\u0421\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u043F\u043E\u0435\u0437\u0434\u043A\u0438:
      \u0411\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E"
  - key: special.travel.start_reward
    en: "If you pass Start, you earn +{0} \u20B5."
    tr: "Ba\u015Flang\u0131\xE7tan ge\xE7ersen +{0} \u20B5 kazan\u0131rs\u0131n."
    es: "Si pasas por Inicio, ganas +{0} \u20B5."
    fr: "Si vous passez par D\xE9part, vous gagnez +{0} \u20B5."
    de: "Wenn du Start passierst, erh\xE4ltst du +{0} \u20B5."
    ko: "\uC2DC\uC791 \uCE78\uC744 \uC9C0\uB098\uBA74 +{0} \u20B5\uB97C \uBC1B\uC2B5\uB2C8\uB2E4."
    ru: "\u0415\u0441\u043B\u0438 \u0432\u044B \u043F\u0440\u043E\u0439\u0434\u0451\u0442\u0435
      \u0447\u0435\u0440\u0435\u0437 \u0421\u0442\u0430\u0440\u0442, \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435
      +{0} \u20B5."
  - key: special.travel.insufficient
    en: 'Insufficient balance: you cannot travel.'
    tr: 'Bakiye yetersiz: seyahat edemezsin.'
    es: 'Saldo insuficiente: no puedes viajar.'
    fr: 'Solde insuffisant : vous ne pouvez pas voyager.'
    de: 'Nicht genug Geld: Du kannst nicht reisen.'
    ko: "\uC794\uC561\uC774 \uBD80\uC871\uD558\uC5EC \uC774\uB3D9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    ru: "\u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u0441\u0440\u0435\u0434\u0441\u0442\u0432: \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435
      \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E."
  - key: special.result.no_money_change
    en: No money change
    tr: "Para de\u011Fi\u015Fmedi"
    es: Sin cambios de dinero
    fr: Aucun changement d'argent
    de: "Keine Geld\xE4nderung"
    ko: "\uAE08\uC561 \uBCC0\uB3D9 \uC5C6\uC74C"
    ru: "\u0414\u0435\u043D\u044C\u0433\u0438 \u043D\u0435 \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0438\u0441\u044C"
  - key: special.result.bankrupt
    en: "BANKRUPT\nPaid: {0} \u20B5\nTransferred/released properties: {1}"
    tr: "\u0130FLAS\n\xD6denen: {0} \u20B5\nDevredilen/bo\u015Fa \xE7\u0131kan m\xFClk:
      {1}"
    es: "BANCARROTA\nPagado: {0} \u20B5\nPropiedades transferidas/liberadas: {1}"
    fr: "FAILLITE\nPay\xE9 : {0} \u20B5\nPropri\xE9t\xE9s transf\xE9r\xE9es/lib\xE9r\xE9es
      : {1}"
    de: "INSOLVENT\nBezahlt: {0} \u20B5\n\xDCbertragene/freigegebene Grundst\xFCcke:
      {1}"
    ko: "\uD30C\uC0B0\n\uC9C0\uBD88: {0} \u20B5\n\uC774\uC804/\uD574\uC81C\uB41C
