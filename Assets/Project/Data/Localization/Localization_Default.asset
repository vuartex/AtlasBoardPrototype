    ko: "\uC720\uD6A8\uD55C \uC785\uCC30\uC774 \uC5C6\uC2B5\uB2C8\uB2E4.\n\uBD80\uB3D9\uC0B0\uC774
      \uD310\uB9E4\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    ru: "\u041D\u0435\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
      \u0441\u0442\u0430\u0432\u043A\u0438.\n\u0421\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      \u043D\u0435 \u043F\u0440\u043E\u0434\u0430\u043D\u0430."
  - key: auction.winner_cannot_pay
    en: 'The winning bid could not be paid.

      Property was not sold.'
    tr: "Kazanan teklif \xF6denemedi.\nM\xFClk sat\u0131lmad\u0131."
    es: "No se pudo pagar la oferta ganadora.\nLa propiedad no se vendi\xF3."
    fr: "L'offre gagnante n'a pas pu \xEAtre pay\xE9e.\nLa propri\xE9t\xE9 n'a pas
      \xE9t\xE9 vendue."
    de: "Das Siegergebot konnte nicht bezahlt werden.\nDas Grundst\xFCck wurde nicht
      verkauft."
    ko: "\uB099\uCC30\uAE08\uC744 \uC9C0\uBD88\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\uBD80\uB3D9\uC0B0\uC774
      \uD310\uB9E4\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    ru: "\u041F\u043E\u0431\u0435\u0434\u043D\u0443\u044E \u0441\u0442\u0430\u0432\u043A\u0443
      \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043E\u043F\u043B\u0430\u0442\u0438\u0442\u044C.\n\u0421\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      \u043D\u0435 \u043F\u0440\u043E\u0434\u0430\u043D\u0430."
  - key: auction.ownership_failed
    en: 'Ownership could not be transferred.

      Bid refunded.'
    tr: "M\xFClkiyet aktar\u0131lamad\u0131.\nTeklif iade edildi."
    es: 'No se pudo transferir la propiedad.

      Oferta reembolsada.'
    fr: "Le transfert de propri\xE9t\xE9 a \xE9chou\xE9.\nOffre rembours\xE9e."
    de: "Eigentum konnte nicht \xFCbertragen werden.\nGebot erstattet."
    ko: "\uC18C\uC720\uAD8C\uC744 \uC774\uC804\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\uC785\uCC30\uAE08\uC774
      \uD658\uBD88\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    ru: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C
      \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C.\n\u0421\u0442\u0430\u0432\u043A\u0430
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0430."
  - key: auction.winner_result
    en: "{0} won!\n{1}\nWinning bid: {2} \u20B5"
    tr: "{0} kazand\u0131!\n{1}\nKazanan teklif: {2} \u20B5"
    es: "\xA1{0} gan\xF3!\n{1}\nOferta ganadora: {2} \u20B5"
    fr: "{0} a gagn\xE9 !\n{1}\nOffre gagnante : {2} \u20B5"
    de: "{0} hat gewonnen!\n{1}\nSiegergebot: {2} \u20B5"
    ko: "{0} \uC2B9\uB9AC!\n{1}\n\uB099\uCC30\uAC00: {2} \u20B5"
    ru: "{0} \u043F\u043E\u0431\u0435\u0434\u0438\u043B!\n{1}\n\u041F\u043E\u0431\u0435\u0434\u043D\u0430\u044F
      \u0441\u0442\u0430\u0432\u043A\u0430: {2} \u20B5"
  - key: auction.insufficient_balance
    en: "{0} does not have enough money.\nRequired: {1} \u20B5 | Available: {2} \u20B5"
    tr: "{0} i\xE7in yetersiz bakiye.\nGerekli: {1} \u20B5 | Mevcut: {2} \u20B5"
    es: "{0} no tiene suficiente dinero.\nNecesario: {1} \u20B5 | Disponible: {2}
      \u20B5"
    fr: "Solde insuffisant pour {0}.\nRequis : {1} \u20B5 | Disponible : {2} \u20B5"
    de: "{0} hat nicht genug Geld.\nBen\xF6tigt: {1} \u20B5 | Verf\xFCgbar: {2} \u20B5"
    ko: "{0}\uC758 \uC794\uC561\uC774 \uBD80\uC871\uD569\uB2C8\uB2E4.\n\uD544\uC694:
      {1} \u20B5 | \uBCF4\uC720: {2} \u20B5"
    ru: "\u0423 {0} \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u0434\u0435\u043D\u0435\u0433.\n\u041D\u0443\u0436\u043D\u043E: {1} \u20B5
      | \u0414\u043E\u0441\u0442\u0443\u043F\u043D\u043E: {2} \u20B5"
  - key: event.card.event_positive_large_order.title
    en: Large Order
    tr: "B\xFCy\xFCk Sipari\u015F"
    es: Gran pedido
    fr: Commande importante
    de: "Gro\xDFauftrag"
    ko: "\uB300\uADDC\uBAA8 \uC8FC\uBB38"
    ru: "\u041A\u0440\u0443\u043F\u043D\u044B\u0439 \u0437\u0430\u043A\u0430\u0437"
  - key: event.card.event_positive_large_order.description
    en: You received an unexpectedly large order.
    tr: "Beklenmedik b\xFCy\xFCk bir sipari\u015F ald\u0131n."
    es: Recibiste un pedido inesperadamente grande.
    fr: "Vous avez re\xE7u une commande exceptionnellement importante."
    de: "Du hast unerwartet einen Gro\xDFauftrag erhalten."
    ko: "\uC608\uC0C1\uCE58 \uBABB\uD55C \uB300\uADDC\uBAA8 \uC8FC\uBB38\uC744 \uBC1B\uC558\uC2B5\uB2C8\uB2E4."
    ru: "\u0412\u044B \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u043A\u0440\u0443\u043F\u043D\u044B\u0439
      \u0437\u0430\u043A\u0430\u0437."
  - key: event.card.event_positive_busy_season.title
    en: Busy Season
    tr: "Yo\u011Fun Sezon"
    es: Temporada alta
    fr: Haute saison
    de: Hochsaison
    ko: "\uC131\uC218\uAE30"
    ru: "\u0412\u044B\u0441\u043E\u043A\u0438\u0439 \u0441\u0435\u0437\u043E\u043D"
  - key: event.card.event_positive_busy_season.description
    en: Business went better than expected.
    tr: "\u0130\u015Flerin beklenenden daha iyi gitti."
    es: El negocio fue mejor de lo esperado.
    fr: "Les affaires ont \xE9t\xE9 meilleures que pr\xE9vu."
    de: "Das Gesch\xE4ft lief besser als erwartet."
    ko: "\uC0AC\uC5C5\uC774 \uC608\uC0C1\uBCF4\uB2E4 \uC798 \uD480\uB838\uC2B5\uB2C8\uB2E4."
    ru: "\u0414\u0435\u043B\u0430 \u043F\u043E\u0448\u043B\u0438 \u043B\u0443\u0447\u0448\u0435,
      \u0447\u0435\u043C \u043E\u0436\u0438\u0434\u0430\u043B\u043E\u0441\u044C."
  - key: event.card.event_positive_local_support.title
    en: Local Support
    tr: Yerel Destek
    es: Apoyo local
    fr: Soutien local
    de: "Lokale F\xF6rderung"
    ko: "\uC9C0\uC5ED \uC9C0\uC6D0"
    ru: "\u041C\u0435\u0441\u0442\u043D\u0430\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430"
  - key: event.card.event_positive_local_support.description
    en: You received a payment from a local support program.
    tr: "Yerel bir destek program\u0131ndan \xF6deme ald\u0131n."
    es: Recibiste un pago de un programa de apoyo local.
    fr: "Vous avez re\xE7u une aide d'un programme local."
    de: "Du hast eine Zahlung aus einem lokalen F\xF6rderprogramm erhalten."
    ko: "\uC9C0\uC5ED \uC9C0\uC6D0 \uD504\uB85C\uADF8\uB7A8\uC5D0\uC11C \uC9C0\uC6D0\uAE08\uC744
      \uBC1B\uC558\uC2B5\uB2C8\uB2E4."
    ru: "\u0412\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u0432\u044B\u043F\u043B\u0430\u0442\u0443
      \u043F\u043E \u043C\u0435\u0441\u0442\u043D\u043E\u0439 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0435
      \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438."
  - key: event.card.event_positive_investment.title
    en: New Investment
    tr: "Yeni Yat\u0131r\u0131m"
    es: "Nueva inversi\xF3n"
    fr: Nouvel investissement
    de: Neue Investition
    ko: "\uC2E0\uADDC \uD22C\uC790"
    ru: "\u041D\u043E\u0432\u0430\u044F \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u044F"
  - key: event.card.event_positive_investment.description
    en: A new investment opportunity provided extra resources.
    tr: "Yeni bir yat\u0131r\u0131m f\u0131rsat\u0131 sana ek kaynak sa\u011Flad\u0131."
    es: "Una nueva oportunidad de inversi\xF3n te dio recursos adicionales."
    fr: "Une nouvelle opportunit\xE9 d'investissement vous a apport\xE9 des ressources
      suppl\xE9mentaires."
    de: "Eine neue Investitionsm\xF6glichkeit brachte zus\xE4tzliche Mittel."
    ko: "\uC0C8\uB85C\uC6B4 \uD22C\uC790 \uAE30\uD68C\uB85C \uCD94\uAC00 \uC790\uAE08\uC744
      \uD655\uBCF4\uD588\uC2B5\uB2C8\uB2E4."
    ru: "\u041D\u043E\u0432\u0430\u044F \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u043E\u043D\u043D\u0430\u044F
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0430
      \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430."
  - key: event.card.event_positive_savings.title
    en: Savings Success
    tr: "Tasarruf Ba\u015Far\u0131s\u0131"
    es: Ahorro exitoso
    fr: "\xC9conomies r\xE9ussies"
    de: Erfolgreich gespart
    ko: "\uC808\uC57D \uC131\uACF5"
    ru: "\u0423\u0434\u0430\u0447\u043D\u0430\u044F \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u044F"
  - key: event.card.event_positive_savings.description
    en: You closed the period with lower expenses than expected.
    tr: "Beklenenden d\xFC\u015F\xFCk giderlerle d\xF6nemi kapatt\u0131n."
    es: Cerraste el periodo con menos gastos de lo esperado.
    fr: "Vous avez termin\xE9 la p\xE9riode avec moins de d\xE9penses que pr\xE9vu."
    de: Du hast den Zeitraum mit geringeren Ausgaben als erwartet abgeschlossen.
    ko: "\uC608\uC0C1\uBCF4\uB2E4 \uC801\uC740 \uBE44\uC6A9\uC73C\uB85C \uAE30\uAC04\uC744
      \uB9C8\uCCE4\uC2B5\uB2C8\uB2E4."
    ru: "\u0412\u044B \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043B\u0438 \u043F\u0435\u0440\u0438\u043E\u0434
      \u0441 \u043C\u0435\u043D\u044C\u0448\u0438\u043C\u0438 \u0440\u0430\u0441\u0445\u043E\u0434\u0430\u043C\u0438,
      \u0447\u0435\u043C \u043E\u0436\u0438\u0434\u0430\u043B\u043E\u0441\u044C."
  - key: event.card.event_positive_campaign.title
    en: Campaign Success
    tr: "Kampanya Ba\u015Far\u0131s\u0131"
    es: "Campa\xF1a exitosa"
    fr: "Campagne r\xE9ussie"
    de: Erfolgreiche Kampagne
    ko: "\uCEA0\uD398\uC778 \uC131\uACF5"
    ru: "\u0423\u0441\u043F\u0435\u0448\u043D\u0430\u044F \u043A\u0430\u043C\u043F\u0430\u043D\u0438\u044F"
  - key: event.card.event_positive_campaign.description
    en: Your campaign generated a strong return.
    tr: "Yapt\u0131\u011F\u0131n kampanya g\xFC\xE7l\xFC bir geri d\xF6n\xFC\u015F
      sa\u011Flad\u0131."
    es: "Tu campa\xF1a gener\xF3 un gran retorno."
    fr: "Votre campagne a g\xE9n\xE9r\xE9 un excellent retour."
    de: Deine Kampagne brachte einen starken Ertrag.
    ko: "\uCEA0\uD398\uC778\uC774 \uD070 \uC131\uACFC\uB97C \uB0C8\uC2B5\uB2C8\uB2E4."
    ru: "\u0412\u0430\u0448\u0430 \u043A\u0430\u043C\u043F\u0430\u043D\u0438\u044F
      \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0430 \u0432\u044B\u0441\u043E\u043A\u0438\u0439
      \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442."
  - key: event.card.event_positive_tax_refund.title
    en: Tax Refund
    tr: "Vergi \u0130adesi"
    es: Reembolso fiscal
    fr: Remboursement fiscal
    de: "Steuerr\xFCckzahlung"
    ko: "\uC138\uAE08 \uD658\uAE09"
    ru: "\u0412\u043E\u0437\u0432\u0440\u0430\u0442 \u043D\u0430\u043B\u043E\u0433\u0430"
  - key: event.card.event_positive_tax_refund.description
    en: You received a larger tax refund than expected.
    tr: "Beklenenden y\xFCksek bir vergi iadesi ald\u0131n."
    es: Recibiste un reembolso fiscal mayor de lo esperado.
    fr: "Vous avez re\xE7u un remboursement fiscal plus \xE9lev\xE9 que pr\xE9vu."
    de: "Du hast eine h\xF6here Steuerr\xFCckzahlung als erwartet erhalten."
    ko: "\uC608\uC0C1\uBCF4\uB2E4 \uD070 \uC138\uAE08 \uD658\uAE09\uC744 \uBC1B\uC558\uC2B5\uB2C8\uB2E4."
    ru: "\u0412\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u0438\u0439
      \u0432\u043E\u0437\u0432\u0440\u0430\u0442 \u043D\u0430\u043B\u043E\u0433\u0430,
      \u0447\u0435\u043C \u043E\u0436\u0438\u0434\u0430\u043B\u043E\u0441\u044C."
  - key: event.card.event_positive_supplier_discount.title
    en: Supplier Discount
    tr: "Tedarik\xE7i \u0130ndirimi"
    es: Descuento del proveedor
    fr: Remise fournisseur
    de: Lieferantenrabatt
    ko: "\uACF5\uAE09\uC5C5\uCCB4 \uD560\uC778"
    ru: "\u0421\u043A\u0438\u0434\u043A\u0430 \u043F\u043E\u0441\u0442\u0430\u0432\u0449\u0438\u043A\u0430"
  - key: event.card.event_positive_supplier_discount.description
    en: Your supplier gave you a special discount.
    tr: "Tedarik\xE7in \xF6zel bir indirim uygulad\u0131."
    es: "Tu proveedor te ofreci\xF3 un descuento especial."
    fr: "Votre fournisseur vous a accord\xE9 une remise sp\xE9ciale."
    de: "Dein Lieferant hat dir einen Sonderrabatt gew\xE4hrt."
    ko: "\uACF5\uAE09\uC5C5\uCCB4\uAC00 \uD2B9\uBCC4 \uD560\uC778\uC744 \uC81C\uACF5\uD588\uC2B5\uB2C8\uB2E4."
    ru: "\u041F\u043E\u0441\u0442\u0430\u0432\u0449\u0438\u043A \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u0432\u0430\u043C \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u0443\u044E
      \u0441\u043A\u0438\u0434\u043A\u0443."
  - key: event.card.event_positive_viral_post.title
    en: Viral Post
    tr: "Viral Payla\u015F\u0131m"
    es: "Publicaci\xF3n viral"
    fr: Publication virale
    de: Viraler Beitrag
    ko: "\uBC14\uC774\uB7F4 \uAC8C\uC2DC\uBB3C"
    ru: "\u0412\u0438\u0440\u0443\u0441\u043D\u0430\u044F \u043F\u0443\u0431\u043B\u0438\u043A\u0430\u0446\u0438\u044F"
  - key: event.card.event_positive_viral_post.description
    en: One of your posts unexpectedly gained attention.
    tr: "Bir payla\u015F\u0131m\u0131n beklenmedik \u015Fekilde ilgi g\xF6rd\xFC."
    es: "Una de tus publicaciones llam\xF3 la atenci\xF3n inesperadamente."
    fr: "L'une de vos publications a attir\xE9 une attention inattendue."
    de: "Einer deiner Beitr\xE4ge bekam unerwartet viel Aufmerksamkeit."
    ko: "\uAC8C\uC2DC\uBB3C \uD558\uB098\uAC00 \uC608\uC0C1\uCE58 \uBABB\uD558\uAC8C
      \uD070 \uAD00\uC2EC\uC744 \uBC1B\uC558\uC2B5\uB2C8\uB2E4."
    ru: "\u041E\u0434\u043D\u0430 \u0438\u0437 \u0432\u0430\u0448\u0438\u0445 \u043F\u0443\u0431\u043B\u0438\u043A\u0430\u0446\u0438\u0439
      \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u043B\u0430
      \u043C\u043D\u043E\u0433\u043E \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F."
  - key: event.card.event_positive_partnership.title
    en: New Partnership
    tr: "Yeni Ortakl\u0131k"
    es: Nueva alianza
    fr: Nouveau partenariat
    de: Neue Partnerschaft
    ko: "\uC0C8 \uD30C\uD2B8\uB108\uC2ED"
    ru: "\u041D\u043E\u0432\u043E\u0435 \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u0441\u0442\u0432\u043E"
  - key: event.card.event_positive_partnership.description
    en: A new partnership generated extra income.
    tr: "Yeni bir ortakl\u0131k ek gelir sa\u011Flad\u0131."
    es: "Una nueva alianza gener\xF3 ingresos adicionales."
    fr: "Un nouveau partenariat a g\xE9n\xE9r\xE9 des revenus suppl\xE9mentaires."
    de: "Eine neue Partnerschaft brachte zus\xE4tzliche Einnahmen."
    ko: "\uC0C8\uB85C\uC6B4 \uD30C\uD2B8\uB108\uC2ED\uC73C\uB85C \uCD94\uAC00 \uC218\uC775\uC744
      \uC5BB\uC5C8\uC2B5\uB2C8\uB2E4."
    ru: "\u041D\u043E\u0432\u043E\u0435 \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u0441\u0442\u0432\u043E
      \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u043E \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0434\u043E\u0445\u043E\u0434."
  - key: event.card.event_positive_insurance_refund.title
    en: Insurance Refund
    tr: "Sigorta \u0130adesi"
    es: Reembolso del seguro
    fr: Remboursement d'assurance
    de: "Versicherungsr\xFCckzahlung"
    ko: "\uBCF4\uD5D8 \uD658\uAE09"
    ru: "\u0421\u0442\u0440\u0430\u0445\u043E\u0432\u0430\u044F \u0432\u044B\u043F\u043B\u0430\u0442\u0430"
  - key: event.card.event_positive_insurance_refund.description
    en: You received a reimbursement from an old claim.
    tr: "Eski bir dosyadan geri \xF6deme ald\u0131n."
    es: "Recibiste un reembolso de una reclamaci\xF3n anterior."
    fr: "Vous avez re\xE7u un remboursement li\xE9 \xE0 un ancien dossier."
    de: "Du hast eine R\xFCckzahlung aus einem alten Versicherungsfall erhalten."
    ko: "\uC774\uC804 \uBCF4\uD5D8 \uCCAD\uAD6C\uC5D0\uC11C \uD658\uAE09\uAE08\uC744
      \uBC1B\uC558\uC2B5\uB2C8\uB2E4."
    ru: "\u0412\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u0432\u044B\u043F\u043B\u0430\u0442\u0443
      \u043F\u043E \u0441\u0442\u0430\u0440\u043E\u043C\u0443 \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u043E\u043C\u0443
      \u0441\u043B\u0443\u0447\u0430\u044E."
  - key: event.card.event_positive_efficiency.title
    en: Efficient Month
    tr: Verimli Ay
    es: Mes eficiente
    fr: Mois efficace
    de: Effizienter Monat
    ko: "\uD6A8\uC728\uC801\uC778 \uD55C \uB2EC"
    ru: "\u042D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0439 \u043C\u0435\u0441\u044F\u0446"
  - key: event.card.event_positive_efficiency.description
    en: Operational efficiency saved more than expected.
    tr: "Operasyonel verimlilik beklenenden fazla tasarruf sa\u011Flad\u0131."
    es: "La eficiencia operativa ahorr\xF3 m\xE1s de lo esperado."
    fr: "L'efficacit\xE9 op\xE9rationnelle a permis d'\xE9conomiser plus que pr\xE9vu."
    de: Betriebliche Effizienz sparte mehr als erwartet.
    ko: "\uC6B4\uC601 \uD6A8\uC728\uD654\uB85C \uC608\uC0C1\uBCF4\uB2E4 \uB9CE\uC740
      \uBE44\uC6A9\uC744 \uC808\uAC10\uD588\uC2B5\uB2C8\uB2E4."
    ru: "\u041E\u043F\u0435\u0440\u0430\u0446\u0438\u043E\u043D\u043D\u0430\u044F
      \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
      \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u0430 \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u044C
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043E\u0436\u0438\u0434\u0430\u0435\u043C\u043E\u0433\u043E."
  - key: event.card.event_negative_maintenance.title
    en: Maintenance Cost
    tr: "Bak\u0131m Masraf\u0131"
    es: Coste de mantenimiento
    fr: Frais d'entretien
    de: Wartungskosten
    ko: "\uC720\uC9C0\uBCF4\uC218 \uBE44\uC6A9"
    ru: "\u0420\u0430\u0441\u0445\u043E\u0434\u044B \u043D\u0430 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0435"
  - key: event.card.event_negative_maintenance.description
    en: Unexpected maintenance expenses appeared.
    tr: "Beklenmedik bak\u0131m giderleri \xE7\u0131kt\u0131."
    es: Aparecieron gastos de mantenimiento inesperados.
    fr: "Des frais d'entretien impr\xE9vus sont apparus."
    de: Unerwartete Wartungskosten sind angefallen.
    ko: "\uC608\uC0C1\uCE58 \uBABB\uD55C \uC720\uC9C0\uBCF4\uC218 \uBE44\uC6A9\uC774
      \uBC1C\uC0DD\uD588\uC2B5\uB2C8\uB2E4."
    ru: "\u0412\u043E\u0437\u043D\u0438\u043A\u043B\u0438 \u043D\u0435\u043F\u0440\u0435\u0434\u0432\u0438\u0434\u0435\u043D\u043D\u044B\u0435
      \u0440\u0430\u0441\u0445\u043E\u0434\u044B \u043D\u0430 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0435."
  - key: event.card.event_negative_market_drop.title
    en: Market Drop
    tr: "Piyasa D\xFC\u015F\xFC\u015F\xFC"
    es: "Ca\xEDda del mercado"
    fr: "Baisse du march\xE9"
    de: "Marktr\xFCckgang"
    ko: "\uC2DC\uC7A5 \uD558\uB77D"
    ru: "\u041F\u0430\u0434\u0435\u043D\u0438\u0435 \u0440\u044B\u043D\u043A\u0430"
  - key: event.card.event_negative_market_drop.description
    en: Market volatility affected your income.
    tr: Piyasadaki dalgalanma gelirini etkiledi.
    es: "La volatilidad del mercado afect\xF3 tus ingresos."
    fr: "La volatilit\xE9 du march\xE9 a affect\xE9 vos revenus."
    de: "Marktschwankungen haben deine Einnahmen beeintr\xE4chtigt."
    ko: "\uC2DC\uC7A5 \uBCC0\uB3D9\uC73C\uB85C \uC218\uC785\uC774 \uC904\uC5C8\uC2B5\uB2C8\uB2E4."
    ru: "\u041A\u043E\u043B\u0435\u0431\u0430\u043D\u0438\u044F \u0440\u044B\u043D\u043A\u0430
      \u043F\u043E\u0432\u043B\u0438\u044F\u043B\u0438 \u043D\u0430 \u0432\u0430\u0448
      \u0434\u043E\u0445\u043E\u0434."
  - key: event.card.event_negative_invoice.title
    en: Unexpected Invoice
    tr: Beklenmedik Fatura
    es: Factura inesperada
    fr: "Facture impr\xE9vue"
    de: Unerwartete Rechnung
    ko: "\uC608\uC0C1\uCE58 \uBABB\uD55C \uCCAD\uAD6C\uC11C"
    ru: "\u041D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u044B\u0439 \u0441\u0447\u0451\u0442"
  - key: event.card.event_negative_invoice.description
    en: An unplanned business invoice arrived.
    tr: "Planlanmayan bir i\u015Fletme faturas\u0131 geldi."
    es: "Lleg\xF3 una factura comercial no planificada."
    fr: "Une facture professionnelle impr\xE9vue est arriv\xE9e."
    de: "Eine ungeplante Gesch\xE4ftsrechnung ist eingegangen."
    ko: "\uC608\uC815\uC5D0 \uC5C6\uB358 \uC0AC\uC5C5 \uCCAD\uAD6C\uC11C\uAC00 \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4."
    ru: "\u041F\u043E\u0441\u0442\u0443\u043F\u0438\u043B \u043D\u0435\u0437\u0430\u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u0434\u0435\u043B\u043E\u0432\u043E\u0439 \u0441\u0447\u0451\u0442."
  - key: event.card.event_negative_damage.title
    en: Damage Expense
    tr: Hasar Gideri
    es: "Gasto por da\xF1os"
    fr: "Frais de r\xE9paration"
    de: Schadenskosten
    ko: "\uC190\uC0C1 \uBE44\uC6A9"
    ru: "\u0420\u0430\u0441\u0445\u043E\u0434\u044B \u043D\u0430 \u0443\u0449\u0435\u0440\u0431"
  - key: event.card.event_negative_damage.description
    en: You need to pay for minor damage.
    tr: "K\xFC\xE7\xFCk bir hasar i\xE7in \xF6deme yapman gerekiyor."
    es: "Debes pagar por unos da\xF1os menores."
    fr: "Vous devez payer pour des d\xE9g\xE2ts mineurs."
    de: "Du musst f\xFCr einen kleinen Schaden bezahlen."
    ko: "\uACBD\uBBF8\uD55C \uC190\uC0C1\uC5D0 \uB300\uD55C \uBE44\uC6A9\uC744 \uC9C0\uBD88\uD574\uC57C
      \uD569\uB2C8\uB2E4."
    ru: "\u041D\u0443\u0436\u043D\u043E \u043E\u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0443\u0449\u0435\u0440\u0431."
  - key: event.card.event_negative_supply.title
    en: Supply Issue
    tr: Tedarik Sorunu
    es: Problema de suministro
    fr: "Probl\xE8me d'approvisionnement"
    de: Lieferproblem
    ko: "\uACF5\uAE09 \uBB38\uC81C"
    ru: "\u041F\u0440\u043E\u0431\u043B\u0435\u043C\u0430 \u0441 \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0430\u043C\u0438"
  - key: event.card.event_negative_supply.description
    en: A supply-chain disruption created extra costs.
    tr: "Tedarik zincirindeki aksama ek maliyet \xE7\u0131kard\u0131."
    es: "Una interrupci\xF3n de la cadena de suministro gener\xF3 costes adicionales."
    fr: "Une perturbation de la cha\xEEne d'approvisionnement a entra\xEEn\xE9 des
      co\xFBts suppl\xE9mentaires."
    de: "Eine St\xF6rung in der Lieferkette verursachte zus\xE4tzliche Kosten."
    ko: "\uACF5\uAE09\uB9DD \uCC28\uC9C8\uB85C \uCD94\uAC00 \uBE44\uC6A9\uC774 \uBC1C\uC0DD\uD588\uC2B5\uB2C8\uB2E4."
    ru: "\u0421\u0431\u043E\u0439 \u0432 \u0446\u0435\u043F\u043E\u0447\u043A\u0435
      \u043F\u043E\u0441\u0442\u0430\u0432\u043E\u043A \u043F\u0440\u0438\u0432\u0451\u043B
      \u043A \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
      \u0440\u0430\u0441\u0445\u043E\u0434\u0430\u043C."
  - key: event.card.event_negative_penalty.title
    en: Unexpected Penalty
    tr: Beklenmedik Ceza
    es: "Sanci\xF3n inesperada"
    fr: "P\xE9nalit\xE9 impr\xE9vue"
    de: Unerwartete Strafe
    ko: "\uC608\uC0C1\uCE58 \uBABB\uD55C \uBC8C\uAE08"
    ru: "\u041D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u044B\u0439 \u0448\u0442\u0440\u0430\u0444"
  - key: event.card.event_negative_penalty.description
    en: A violation requires a large payment.
    tr: "Bir ihlal nedeniyle y\xFCksek bir \xF6deme yapman gerekiyor."
    es: "Una infracci\xF3n exige un pago importante."
    fr: "Une infraction vous oblige \xE0 effectuer un paiement important."
    de: "Ein Versto\xDF erfordert eine hohe Zahlung."
    ko: "\uC704\uBC18 \uC0AC\uD56D\uC73C\uB85C \uD070 \uAE08\uC561\uC744 \uC9C0\uBD88\uD574\uC57C
      \uD569\uB2C8\uB2E4."
    ru: "\u0418\u0437-\u0437\u0430 \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u044F
      \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u043A\u0440\u0443\u043F\u043D\u0430\u044F
      \u0432\u044B\u043F\u043B\u0430\u0442\u0430."
  - key: event.card.event_negative_late_fee.title
    en: Late Fee
    tr: Gecikme Bedeli
    es: Cargo por demora
    fr: Frais de retard
    de: "Versp\xE4tungsgeb\xFChr"
    ko: "\uC5F0\uCCB4\uB8CC"
    ru: "\u041F\u043B\u0430\u0442\u0430 \u0437\u0430 \u043F\u0440\u043E\u0441\u0440\u043E\u0447\u043A\u0443"
  - key: event.card.event_negative_late_fee.description
    en: A delayed payment generated an extra fee.
    tr: "Geciken bir \xF6deme i\xE7in ek \xFCcret \xE7\u0131kt\u0131."
    es: "Un pago atrasado gener\xF3 un cargo adicional."
    fr: "Un paiement en retard a entra\xEEn\xE9 des frais suppl\xE9mentaires."
    de: "Eine versp\xE4tete Zahlung verursachte eine zus\xE4tzliche Geb\xFChr."
    ko: "\uC9C0\uC5F0\uB41C \uACB0\uC81C\uB85C \uCD94\uAC00 \uC218\uC218\uB8CC\uAC00
      \uBC1C\uC0DD\uD588\uC2B5\uB2C8\uB2E4."
    ru: "\u041F\u0440\u043E\u0441\u0440\u043E\u0447\u0435\u043D\u043D\u044B\u0439
      \u043F\u043B\u0430\u0442\u0451\u0436 \u043F\u0440\u0438\u0432\u0451\u043B \u043A
      \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
      \u043A\u043E\u043C\u0438\u0441\u0441\u0438\u0438."
  - key: event.card.event_negative_equipment.title
    en: Equipment Repair
    tr: Ekipman Tamiri
    es: "Reparaci\xF3n de equipo"
    fr: "R\xE9paration d'\xE9quipement"
    de: "Ger\xE4tereparatur"
    ko: "\uC7A5\uBE44 \uC218\uB9AC"
    ru: "\u0420\u0435\u043C\u043E\u043D\u0442 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F"
  - key: event.card.event_negative_equipment.description
    en: A piece of equipment needs an urgent repair.
    tr: "Bir ekipman\u0131n acil tamire ihtiyac\u0131 var."
    es: "Un equipo necesita una reparaci\xF3n urgente."
    fr: "Un \xE9quipement n\xE9cessite une r\xE9paration urgente."
    de: "Ein Ger\xE4t muss dringend repariert werden."
    ko: "\uC7A5\uBE44 \uD558\uB098\uB97C \uAE34\uAE09\uD788 \uC218\uB9AC\uD574\uC57C
      \uD569\uB2C8\uB2E4."
    ru: "\u041E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044E
      \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u0441\u0440\u043E\u0447\u043D\u044B\u0439
      \u0440\u0435\u043C\u043E\u043D\u0442."
  - key: event.card.event_negative_delivery.title
    en: Delivery Issue
    tr: Teslimat Sorunu
    es: Problema de entrega
    fr: "Probl\xE8me de livraison"
    de: Lieferproblem
    ko: "\uBC30\uC1A1 \uBB38\uC81C"
    ru: "\u041F\u0440\u043E\u0431\u043B\u0435\u043C\u0430 \u0441 \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u043E\u0439"
  - key: event.card.event_negative_delivery.description
    en: A delivery disruption created extra costs.
    tr: "Teslimattaki aksama ek maliyet olu\u015Fturdu."
    es: "Un problema de entrega gener\xF3 costes adicionales."
    fr: "Un probl\xE8me de livraison a entra\xEEn\xE9 des co\xFBts suppl\xE9mentaires."
    de: "Eine Lieferst\xF6rung verursachte zus\xE4tzliche Kosten."
    ko: "\uBC30\uC1A1 \uCC28\uC9C8\uB85C \uCD94\uAC00 \uBE44\uC6A9\uC774 \uBC1C\uC0DD\uD588\uC2B5\uB2C8\uB2E4."
    ru: "\u0421\u0431\u043E\u0439 \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438
      \u043F\u0440\u0438\u0432\u0451\u043B \u043A \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
      \u0440\u0430\u0441\u0445\u043E\u0434\u0430\u043C."
  - key: event.card.event_negative_permit.title
    en: Permit Cost
    tr: "\u0130zin Masraf\u0131"
    es: Coste de permiso
    fr: Frais d'autorisation
    de: "Genehmigungsgeb\xFChr"
    ko: "\uD5C8\uAC00 \uBE44\uC6A9"
    ru: "\u0420\u0430\u0441\u0445\u043E\u0434\u044B \u043D\u0430 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435"
  - key: event.card.event_negative_permit.description
    en: An unexpected permit and processing fee appeared.
    tr: "Beklenmedik bir izin ve i\u015Flem \xFCcreti \xE7\u0131kt\u0131."
    es: "Apareci\xF3 una tasa inesperada de permiso y gesti\xF3n."
    fr: "Des frais impr\xE9vus d'autorisation et de traitement sont apparus."
    de: "Eine unerwartete Genehmigungs- und Bearbeitungsgeb\xFChr ist angefallen."
    ko: "\uC608\uC0C1\uCE58 \uBABB\uD55C \uD5C8\uAC00 \uBC0F \uCC98\uB9AC \uC218\uC218\uB8CC\uAC00
      \uBC1C\uC0DD\uD588\uC2B5\uB2C8\uB2E4."
    ru: "\u0412\u043E\u0437\u043D\u0438\u043A\u043B\u0438 \u043D\u0435\u043F\u0440\u0435\u0434\u0432\u0438\u0434\u0435\u043D\u043D\u044B\u0435
      \u0441\u0431\u043E\u0440\u044B \u0437\u0430 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435
      \u0438 \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u0438\u0435."
  - key: event.card.event_negative_refunds.title
    en: Refund Wave
    tr: "\u0130ade Dalgas\u0131"
    es: Oleada de reembolsos
    fr: Vague de remboursements
    de: "R\xFCckerstattungswelle"
    ko: "\uD658\uBD88 \uC99D\uAC00"
    ru: "\u0412\u043E\u043B\u043D\u0430 \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u043E\u0432"
  - key: event.card.event_negative_refunds.description
    en: Several refunds had to be paid at the same time.
    tr: "Ayn\u0131 anda birka\xE7 geri \xF6deme yapmak zorunda kald\u0131n."
    es: Tuviste que realizar varios reembolsos al mismo tiempo.
    fr: "Vous avez d\xFB effectuer plusieurs remboursements en m\xEAme temps."
    de: "Du musstest mehrere R\xFCckerstattungen gleichzeitig zahlen."
    ko: "\uC5EC\uB7EC \uAC74\uC758 \uD658\uBD88\uC744 \uD55C\uAEBC\uBC88\uC5D0 \uCC98\uB9AC\uD574\uC57C
      \uD588\uC2B5\uB2C8\uB2E4."
    ru: "\u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
      \u043E\u0444\u043E\u0440\u043C\u0438\u0442\u044C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u043E\u0432."
  - key: event.card.event_negative_utility.title
    en: High Utility Bill
    tr: "Y\xFCksek Fatura"
    es: Factura elevada
    fr: "Facture \xE9lev\xE9e"
    de: Hohe Betriebskosten
    ko: "\uB192\uC740 \uACF5\uACFC\uAE08"
    ru: "\u0412\u044B\u0441\u043E\u043A\u0438\u0439 \u0441\u0447\u0451\u0442"
  - key: event.card.event_negative_utility.description
    en: Energy and service expenses increased this month.
    tr: "Enerji ve hizmet giderleri bu ay y\xFCkseldi."
    es: "Los gastos de energ\xEDa y servicios aumentaron este mes."
    fr: "Les d\xE9penses d'\xE9nergie et de services ont augment\xE9 ce mois-ci."
    de: Energie- und Betriebskosten sind diesen Monat gestiegen.
    ko: "\uC774\uBC88 \uB2EC \uC5D0\uB108\uC9C0\uC640 \uC11C\uBE44\uC2A4 \uBE44\uC6A9\uC774
      \uC99D\uAC00\uD588\uC2B5\uB2C8\uB2E4."
    ru: "\u0412 \u044D\u0442\u043E\u043C \u043C\u0435\u0441\u044F\u0446\u0435 \u0432\u044B\u0440\u043E\u0441\u043B\u0438
      \u0440\u0430\u0441\u0445\u043E\u0434\u044B \u043D\u0430 \u044D\u043D\u0435\u0440\u0433\u0438\u044E
      \u0438 \u0443\u0441\u043B\u0443\u0433\u0438."
  - key: event.card.event_special_rest_day.title
    en: Mandatory Break
    tr: Zorunlu Mola
    es: Pausa obligatoria
    fr: Pause obligatoire
    de: Zwangspause
    ko: "\uAC15\uC81C \uD734\uC2DD"
    ru: "\u0412\u044B\u043D\u0443\u0436\u0434\u0435\u043D\u043D\u044B\u0439 \u043F\u0435\u0440\u0435\u0440\u044B\u0432"
  - key: event.card.event_special_rest_day.description
    en: You need to take an unplanned break.
    tr: "Plan d\u0131\u015F\u0131 bir mola vermen gerekiyor."
    es: Debes hacer una pausa no planificada.
    fr: "Vous devez prendre une pause impr\xE9vue."
    de: Du musst eine ungeplante Pause einlegen.
    ko: "\uC608\uC815\uC5D0 \uC5C6\uB358 \uD734\uC2DD\uC744 \uCDE8\uD574\uC57C \uD569\uB2C8\uB2E4."
    ru: "\u0412\u0430\u043C \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u043D\u0435\u0437\u0430\u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u043F\u0435\u0440\u0435\u0440\u044B\u0432."
  - key: event.card.event_special_move_3.title
    en: Fast Progress
    tr: "H\u0131zl\u0131 \u0130lerleme"
    es: "Avance r\xE1pido"
    fr: Progression rapide
    de: Schneller Fortschritt
    ko: "\uBE60\uB978 \uC804\uC9C4"
    ru: "\u0411\u044B\u0441\u0442\u0440\u043E\u0435 \u043F\u0440\u043E\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435"
  - key: event.card.event_special_move_3.description
    en: Things sped up. Move forward three spaces.
    tr: "\u0130\u015Fler h\u0131zland\u0131. \xDC\xE7 kare ileri git."
    es: "Todo se aceler\xF3. Avanza tres casillas."
    fr: "Les choses s'acc\xE9l\xE8rent. Avancez de trois cases."
    de: Es geht schneller voran. Gehe drei Felder vor.
    ko: "\uC77C\uC774 \uBE68\uB77C\uC84C\uC2B5\uB2C8\uB2E4. \uC138 \uCE78 \uC804\uC9C4\uD558\uC138\uC694."
    ru: "\u0414\u0435\u043B\u0430 \u0443\u0441\u043A\u043E\u0440\u0438\u043B\u0438\u0441\u044C.
      \u041F\u0440\u043E\u0434\u0432\u0438\u043D\u044C\u0442\u0435\u0441\u044C \u043D\u0430
      \u0442\u0440\u0438 \u043A\u043B\u0435\u0442\u043A\u0438."
  - key: event.card.event_special_move_5.title
    en: Big Opportunity
    tr: "B\xFCy\xFCk F\u0131rsat"
    es: Gran oportunidad
    fr: "Grande opportunit\xE9"
    de: "Gro\xDFe Chance"
    ko: "\uD070 \uAE30\uD68C"
    ru: "\u0411\u043E\u043B\u044C\u0448\u0430\u044F \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C"
  - key: event.card.event_special_move_5.description
    en: A new opportunity moved you ahead. Move forward five spaces.
    tr: "Yeni bir f\u0131rsat seni \xF6ne ta\u015F\u0131d\u0131. Be\u015F kare ileri
      git."
    es: Una nueva oportunidad te impulsa. Avanza cinco casillas.
    fr: "Une nouvelle opportunit\xE9 vous fait avancer. Avancez de cinq cases."
    de: "Eine neue Chance bringt dich voran. Gehe f\xFCnf Felder vor."
    ko: "\uC0C8\uB85C\uC6B4 \uAE30\uD68C\uAC00 \uCC3E\uC544\uC654\uC2B5\uB2C8\uB2E4.
      \uB2E4\uC12F \uCE78 \uC804\uC9C4\uD558\uC138\uC694."
    ru: "\u041D\u043E\u0432\u0430\u044F \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
      \u043F\u0440\u043E\u0434\u0432\u0438\u0433\u0430\u0435\u0442 \u0432\u0430\u0441
      \u0432\u043F\u0435\u0440\u0451\u0434. \u041F\u0440\u043E\u0439\u0434\u0438\u0442\u0435
      \u043F\u044F\u0442\u044C \u043A\u043B\u0435\u0442\u043E\u043A."
  - key: event.card.event_special_to_bonus.title
    en: Bonus Route
    tr: "Bonus Rotas\u0131"
    es: "Ruta de bonificaci\xF3n"
    fr: Route bonus
    de: Bonusroute
    ko: "\uBCF4\uB108\uC2A4 \uACBD\uB85C"
    ru: "\u041F\u0443\u0442\u044C \u043A \u0431\u043E\u043D\u0443\u0441\u0443"
  - key: event.card.event_special_to_bonus.description
    en: Move toward the nearest Bonus space.
    tr: "En yak\u0131n Bonus karesine do\u011Fru ilerle."
    es: "Avanza hacia la casilla de bonificaci\xF3n m\xE1s cercana."
    fr: Avancez vers la case Bonus la plus proche.
    de: "Gehe zum n\xE4chsten Bonusfeld."
    ko: "\uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uBCF4\uB108\uC2A4 \uCE78\uC73C\uB85C \uC774\uB3D9\uD558\uC138\uC694."
    ru: "\u041F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u0435\u0441\u044C
      \u043A \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0439 \u0431\u043E\u043D\u0443\u0441\u043D\u043E\u0439
      \u043A\u043B\u0435\u0442\u043A\u0435."
  - key: event.card.event_special_to_travel.title
    en: New Route
    tr: Yeni Rota
    es: Nueva ruta
    fr: Nouvelle route
    de: Neue Route
    ko: "\uC0C8 \uACBD\uB85C"
    ru: "\u041D\u043E\u0432\u044B\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442"
  - key: event.card.event_special_to_travel.description
    en: Move toward the nearest Travel space.
    tr: "En yak\u0131n Seyahat karesine do\u011Fru ilerle."
    es: "Avanza hacia la casilla de viaje m\xE1s cercana."
    fr: Avancez vers la case Voyage la plus proche.
    de: "Gehe zum n\xE4chsten Reisefeld."
    ko: "\uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC5EC\uD589 \uCE78\uC73C\uB85C \uC774\uB3D9\uD558\uC138\uC694."
    ru: "\u041F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u0435\u0441\u044C
      \u043A \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0439 \u043A\u043B\u0435\u0442\u043A\u0435
      \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044F."
  - key: event.card.event_special_to_auction.title
    en: Market Opportunity
    tr: "Pazar F\u0131rsat\u0131"
    es: Oportunidad de mercado
    fr: "Opportunit\xE9 de march\xE9"
    de: Marktchance
    ko: "\uC2DC\uC7A5 \uAE30\uD68C"
    ru: "\u0420\u044B\u043D\u043E\u0447\u043D\u0430\u044F \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C"
  - key: event.card.event_special_to_auction.description
    en: Move toward the nearest Auction space.
    tr: "En yak\u0131n A\xE7\u0131k Art\u0131rma karesine do\u011Fru ilerle."
    es: "Avanza hacia la casilla de subasta m\xE1s cercana."
    fr: "Avancez vers la case Ench\xE8re la plus proche."
    de: "Gehe zum n\xE4chsten Auktionsfeld."
    ko: "\uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uACBD\uB9E4 \uCE78\uC73C\uB85C \uC774\uB3D9\uD558\uC138\uC694."
    ru: "\u041F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u0435\u0441\u044C
      \u043A \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0439 \u043A\u043B\u0435\u0442\u043A\u0435
      \u0430\u0443\u043A\u0446\u0438\u043E\u043D\u0430."
  - key: event.card.event_special_move_2.title
    en: Small Advantage
    tr: "K\xFC\xE7\xFCk Avantaj"
    es: "Peque\xF1a ventaja"
    fr: Petit avantage
    de: Kleiner Vorteil
    ko: "\uC791\uC740 \uC774\uC810"
    ru: "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
  - key: event.card.event_special_move_2.description
    en: Move forward two spaces.
    tr: "\u0130ki kare ileri git."
    es: Avanza dos casillas.
    fr: Avancez de deux cases.
    de: Gehe zwei Felder vor.
    ko: "\uB450 \uCE78 \uC804\uC9C4\uD558\uC138\uC694."
    ru: "\u041F\u0440\u043E\u0434\u0432\u0438\u043D\u044C\u0442\u0435\u0441\u044C
      \u043D\u0430 \u0434\u0432\u0435 \u043A\u043B\u0435\u0442\u043A\u0438."
  - key: event.card.event_special_move_4.title
    en: Gained Momentum
    tr: "H\u0131z Kazand\u0131n"
    es: Has ganado impulso
    fr: "Vous prenez de l'\xE9lan"
    de: Du nimmst Fahrt auf
    ko: "\uC18D\uB3C4 \uC0C1\uC2B9"
    ru: "\u041D\u0430\u0431\u0440\u0430\u043D\u043D\u044B\u0439 \u0442\u0435\u043C\u043F"
  - key: event.card.event_special_move_4.description
    en: Move forward four spaces.
    tr: "D\xF6rt kare ileri git."
    es: Avanza cuatro casillas.
    fr: Avancez de quatre cases.
    de: Gehe vier Felder vor.
    ko: "\uB124 \uCE78 \uC804\uC9C4\uD558\uC138\uC694."
    ru: "\u041F\u0440\u043E\u0434\u0432\u0438\u043D\u044C\u0442\u0435\u0441\u044C
      \u043D\u0430 \u0447\u0435\u0442\u044B\u0440\u0435 \u043A\u043B\u0435\u0442\u043A\u0438."
  - key: event.card.event_special_move_6.title
    en: Big Leap
    tr: "B\xFCy\xFCk S\u0131\xE7rama"
    es: Gran salto
    fr: Grand bond
    de: "Gro\xDFer Sprung"
    ko: "\uD070 \uB3C4\uC57D"
    ru: "\u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u0440\u044B\u0432\u043E\u043A"
  - key: event.card.event_special_move_6.description
    en: Move forward six spaces.
    tr: "Alt\u0131 kare ileri git."
    es: Avanza seis casillas.
    fr: Avancez de six cases.
    de: Gehe sechs Felder vor.
    ko: "\uC5EC\uC12F \uCE78 \uC804\uC9C4\uD558\uC138\uC694."
    ru: "\u041F\u0440\u043E\u0434\u0432\u0438\u043D\u044C\u0442\u0435\u0441\u044C
      \u043D\u0430 \u0448\u0435\u0441\u0442\u044C \u043A\u043B\u0435\u0442\u043E\u043A."
  - key: event.card.event_special_to_vacation.title
    en: Short Vacation
    tr: "K\u0131sa Tatil"
    es: Vacaciones cortas
    fr: Courtes vacances
    de: Kurzurlaub
    ko: "\uC9E7\uC740 \uD734\uAC00"
    ru: "\u041A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u043E\u0442\u043F\u0443\u0441\u043A"
  - key: event.card.event_special_to_vacation.description
    en: Move toward the nearest Vacation space.
    tr: "En yak\u0131n Tatil karesine do\u011Fru ilerle."
    es: "Avanza hacia la casilla de vacaciones m\xE1s cercana."
    fr: Avancez vers la case Vacances la plus proche.
    de: "Gehe zum n\xE4chsten Urlaubsfeld."
    ko: "\uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uD734\uAC00 \uCE78\uC73C\uB85C \uC774\uB3D9\uD558\uC138\uC694."
    ru: "\u041F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u0435\u0441\u044C
      \u043A \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0439 \u043A\u043B\u0435\u0442\u043A\u0435
      \u043E\u0442\u043F\u0443\u0441\u043A\u0430."
  - key: event.card.event_special_to_rest.title
    en: Rest Stop
    tr: "Dinlenme Noktas\u0131"
    es: Punto de descanso
    fr: Aire de repos
    de: Rastplatz
    ko: "\uD734\uC2DD \uC9C0\uC810"
    ru: "\u041C\u0435\u0441\u0442\u043E \u043E\u0442\u0434\u044B\u0445\u0430"
  - key: event.card.event_special_to_rest.description
    en: Move toward the nearest Rest space.
    tr: "En yak\u0131n Dinlenme karesine do\u011Fru ilerle."
    es: "Avanza hacia la casilla de descanso m\xE1s cercana."
    fr: Avancez vers la case Repos la plus proche.
    de: "Gehe zum n\xE4chsten Rastfeld."
    ko: "\uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uD734\uC2DD \uCE78\uC73C\uB85C \uC774\uB3D9\uD558\uC138\uC694."
    ru: "\u041F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u0435\u0441\u044C
      \u043A \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0439 \u043A\u043B\u0435\u0442\u043A\u0435
      \u043E\u0442\u0434\u044B\u0445\u0430."
  - key: event.card.event_special_skip_2.title
    en: System Outage
    tr: Sistem Kesintisi
    es: "Ca\xEDda del sistema"
    fr: "Panne syst\xE8me"
    de: Systemausfall
    ko: "\uC2DC\uC2A4\uD15C \uC7A5\uC560"
    ru: "\u0421\u0431\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B"
  - key: event.card.event_special_skip_2.description
    en: An unexpected outage makes you wait for two turns.
    tr: Beklenmedik bir kesinti nedeniyle iki tur bekle.
    es: "Una ca\xEDda inesperada te obliga a esperar dos turnos."
    fr: "Une panne impr\xE9vue vous fait attendre deux tours."
    de: "Ein unerwarteter Ausfall l\xE4sst dich zwei Runden aussetzen."
    ko: "\uC608\uC0C1\uCE58 \uBABB\uD55C \uC7A5\uC560\uB85C \uB450 \uD134\uC744 \uC26C\uC5B4\uC57C
      \uD569\uB2C8\uB2E4."
    ru: "\u0418\u0437-\u0437\u0430 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E\u0433\u043E
      \u0441\u0431\u043E\u044F \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435
      \u0434\u0432\u0430 \u0445\u043E\u0434\u0430."
  - key: event.applying
    en: Applying card...
    tr: "Kart uygulan\u0131yor..."
    es: Aplicando carta...
    fr: Application de la carte...
    de: Karte wird angewendet...
    ko: "\uCE74\uB4DC \uC801\uC6A9 \uC911..."
    ru: "\u041F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u043A\u0430\u0440\u0442\u044B..."
  - key: event.effect_none
    en: No effect was applied.
    tr: "Etki uygulanmad\u0131."
    es: "No se aplic\xF3 ning\xFAn efecto."
    fr: "Aucun effet n'a \xE9t\xE9 appliqu\xE9."
    de: Es wurde kein Effekt angewendet.
    ko: "\uD6A8\uACFC\uAC00 \uC801\uC6A9\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    ru: "\u042D\u0444\u0444\u0435\u043A\u0442 \u043D\u0435 \u043F\u0440\u0438\u043C\u0435\u043D\u0451\u043D."
  - key: event.bankrupt_result
    en: "BANKRUPT\nPaid: {0} \u20B5\nTransferred/released properties: {1}"
    tr: "\u0130FLAS\n\xD6denen: {0} \u20B5\nDevredilen/bo\u015Fa \xE7\u0131kan m\xFClk:
      {1}"
    es: "BANCARROTA\nPagado: {0} \u20B5\nPropiedades transferidas/liberadas: {1}"
    fr: "FAILLITE\nPay\xE9 : {0} \u20B5\nPropri\xE9t\xE9s transf\xE9r\xE9es/lib\xE9r\xE9es
      : {1}"
    de: "INSOLVENT\nBezahlt: {0} \u20B5\n\xDCbertragene/freigegebene Grundst\xFCcke:
      {1}"
    ko: "\uD30C\uC0B0\n\uC9C0\uBD88: {0} \u20B5\n\uC774\uC804/\uD574\uC81C\uB41C
      \uBD80\uB3D9\uC0B0: {1}"
    ru: "\u0411\u0410\u041D\u041A\u0420\u041E\u0422\n\u041E\u043F\u043B\u0430\u0447\u0435\u043D\u043E:
      {0} \u20B5\n\u041F\u0435\u0440\u0435\u0434\u0430\u043D\u043E/\u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0435\u043D\u043E
      \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432: {1}"
  - key: event.money_no_change
    en: No money change
    tr: "Para de\u011Fi\u015Fmedi"
    es: Sin cambios de dinero
    fr: Aucun changement d'argent
    de: "Keine Geld\xE4nderung"
    ko: "\uAE08\uC561 \uBCC0\uB3D9 \uC5C6\uC74C"
    ru: "\u0414\u0435\u043D\u044C\u0433\u0438 \u043D\u0435 \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0438\u0441\u044C"
  - key: event.skip_one
    en: You will skip your next turn.
    tr: "Sonraki turunu atlayacaks\u0131n."
    es: "Perder\xE1s tu pr\xF3ximo turno."
    fr: Vous passerez votre prochain tour.
    de: "Du setzt deinen n\xE4chsten Zug aus."
    ko: "\uB2E4\uC74C \uD134\uC744 \uC27D\uB2C8\uB2E4."
    ru: "\u0412\u044B \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0445\u043E\u0434."
  - key: event.skip_many
    en: You will skip your next {0} turns.
    tr: "Sonraki {0} turunu atlayacaks\u0131n."
    es: "Perder\xE1s tus pr\xF3ximos {0} turnos."
    fr: Vous passerez vos {0} prochains tours.
    de: "Du setzt deine n\xE4chsten {0} Z\xFCge aus."
    ko: "\uB2E4\uC74C {0}\uD134\uC744 \uC27D\uB2C8\uB2E4."
    ru: "\u0412\u044B \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435 {0} \u0445\u043E\u0434\u0430."
  - key: event.move_failed
    en: Movement could not be applied.
    tr: "Hareket uygulanamad\u0131."
    es: No se pudo realizar el movimiento.
    fr: "Le d\xE9placement n'a pas pu \xEAtre effectu\xE9."
