      vorgenommen."
    ko: "\uAC70\uB798\uB97C \uC801\uC6A9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uBCC0\uACBD
      \uC0AC\uD56D\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
    ru: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C
