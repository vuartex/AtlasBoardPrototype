    ru: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C
      \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435."
