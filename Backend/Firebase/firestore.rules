rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() &&
        request.auth.uid == uid;
    }

    function supportedLanguage(value) {
      return value is string &&
        value in [
          'en',
          'tr',
          'es',
          'fr',
          'de',
          'ko',
          'ru'
        ];
    }

    function validCountryCode(value) {
      return value is string &&
        value.size() == 2;
    }

    function validProfileString(value, maxLength) {
      return value is string &&
        value.size() <= maxLength;
    }

    function validNewUser(uid) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'schemaVersion',
          'accountStatus',
          'membershipTier',
          'countryCode',
          'preferredLanguage',
          'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'uid',
          'schemaVersion',
          'accountStatus',
          'membershipTier',
          'countryCode',
          'preferredLanguage',
          'createdAt'
        ]) &&
        request.resource.data.uid == uid &&
        request.resource.data.schemaVersion == 1 &&
        request.resource.data.accountStatus == 'active' &&
        request.resource.data.membershipTier == 'normal' &&
        validCountryCode(
          request.resource.data.countryCode
        ) &&
        supportedLanguage(
          request.resource.data.preferredLanguage
        ) &&
        request.resource.data.createdAt is timestamp;
    }

    function validUserLocaleUpdate(uid) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'schemaVersion',
          'accountStatus',
          'membershipTier',
          'countryCode',
          'preferredLanguage',
          'createdAt'
        ]) &&
        request.resource.data.uid == uid &&
        request.resource.data.uid ==
          resource.data.uid &&
        request.resource.data.schemaVersion ==
          resource.data.schemaVersion &&
        request.resource.data.accountStatus ==
          resource.data.accountStatus &&
        request.resource.data.membershipTier ==
          resource.data.membershipTier &&
        request.resource.data.createdAt ==
          resource.data.createdAt &&
        validCountryCode(
          request.resource.data.countryCode
        ) &&
        supportedLanguage(
          request.resource.data.preferredLanguage
        ) &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'countryCode',
            'preferredLanguage'
          ]);
    }

    function validPublicProfile() {
      return request.resource.data.keys().hasOnly([
          'displayName',
          'avatarId',
          'profileFrameId',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'displayName',
          'avatarId',
          'profileFrameId',
          'updatedAt'
        ]) &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() >= 2 &&
        request.resource.data.displayName.size() <= 32 &&
        validProfileString(
          request.resource.data.avatarId,
          128
        ) &&
        validProfileString(
          request.resource.data.profileFrameId,
          128
        ) &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.updatedAt <= request.time &&
        request.resource.data.updatedAt >=
          request.time - duration.value(1, 'm');
    }

    // A display name is a public identity surface and may be changed at most
    // once per 24 hours. Existing avatar/frame-only updates remain allowed,
    // and updatedAt must remain within one minute of request time. Because the current v1 profile
    // schema has one timestamp, any profile update conservatively restarts the
    // rename cooldown rather than opening a bypass.
    function validPublicProfileUpdate() {
      return validPublicProfile() &&
        (
          request.resource.data.displayName ==
            resource.data.displayName ||
          (
            resource.data.updatedAt is timestamp &&
            request.time - resource.data.updatedAt >=
              duration.value(24, 'h')
          )
        );
    }

    // SEC06 v2: isolate device Settings in ONE document per platform.
    // Legacy graphics/gameplay children in /preferences/{uid} are READ-ONLY
    // and remain available during the client-side migration; never overwrite
    // those historical maps from a platform sync.
    function intBetween(v, low, high) {
      return v is int && v >= low && v <= high;
    }

    function audioBetween(v) {
      return v is number && v >= 0 && v <= 1;
    }

    function validAudioV2(section) {
      return section is map &&
        section.keys().hasOnly([
          'master', 'mainMusic', 'theme', 'dice', 'effects', 'muted'
        ]) &&
        audioBetween(section.get('master', 0)) &&
        audioBetween(section.get('mainMusic', 0)) &&
        audioBetween(section.get('theme', 0)) &&
        audioBetween(section.get('dice', 0)) &&
        audioBetween(section.get('effects', 0)) &&
        section.get('muted', false) is bool;
    }

    function validGraphicsV2(section) {
      return section is map &&
        section.keys().hasOnly([
          'resolutionWidth', 'resolutionHeight', 'refreshRate',
          'displayMode', 'qualityPreset', 'vsync', 'fpsLimit',
          'shadowQuality', 'antiAliasing', 'showFps'
        ]) &&
        intBetween(section.get('resolutionWidth', 0), 0, 32768) &&
        intBetween(section.get('resolutionHeight', 0), 0, 32768) &&
        intBetween(section.get('refreshRate', 0), 0, 1000) &&
        intBetween(section.get('displayMode', 0), 0, 2) &&
        intBetween(section.get('qualityPreset', 0), 0, 3) &&
        section.get('vsync', false) is bool &&
        intBetween(section.get('fpsLimit', 0), 0, 1000) &&
        intBetween(section.get('shadowQuality', 0), 0, 3) &&
        intBetween(section.get('antiAliasing', 0), 0, 3) &&
        section.get('showFps', false) is bool;
    }

    function validGlobalGameplayV2(section) {
      return section is map &&
        section.keys().hasOnly([
          'botTurnSpeed', 'uiHints', 'gameplayConfirmations'
        ]) &&
        intBetween(section.get('botTurnSpeed', 50), 1, 100) &&
        section.get('uiHints', false) is bool &&
        section.get('gameplayConfirmations', false) is bool;
    }

    function validPlatformGameplayV2(section) {
      return section is map &&
        section.keys().hasOnly([
          'cameraSensitivity', 'cameraZoomSensitivity',
          'cameraPanSensitivity', 'reduceCameraMotion'
        ]) &&
        intBetween(section.get('cameraSensitivity', 50), 1, 100) &&
        intBetween(section.get('cameraZoomSensitivity', 50), 1, 100) &&
        intBetween(section.get('cameraPanSensitivity', 50), 1, 100) &&
        section.get('reduceCameraMotion', false) is bool;
    }

    function validRootShape(data) {
      return data.keys().hasOnly([
          'language','audio','graphics','controls','gameplay',
          'crossplayPreference','updatedAt'
        ]) &&
        data.keys().hasAll([
          'language','audio','graphics','controls','gameplay',
          'crossplayPreference','updatedAt'
        ]) &&
        supportedLanguage(data.language) &&
        validAudioV2(data.audio) &&
        data.graphics is map &&
        data.controls is map &&
        data.gameplay is map &&
        data.crossplayPreference in ['enabled','disabled'] &&
        data.updatedAt is timestamp;
    }

    function validNewPreferences() {
      return request.resource.data.graphics is map &&
        request.resource.data.graphics.size() == 0 &&
        request.resource.data.controls is map &&
        request.resource.data.controls.size() == 0 &&
        request.resource.data.gameplay is map &&
        request.resource.data.gameplay.size() == 0 &&
        validRootShape(request.resource.data);
    }

    function validRootGameplayDelta(next, previous) {
      return next is map && previous is map &&
        next.diff(previous).affectedKeys().hasOnly(['global']) &&
        (!previous.keys().hasAny(['global']) ||
          next.keys().hasAny(['global'])) &&
        (!next.keys().hasAny(['global']) ||
          validGlobalGameplayV2(next.global));
    }

    function validUpdatedPreferences() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'language','audio','gameplay','crossplayPreference','updatedAt'
        ]) &&
        validRootShape(request.resource.data) &&
        validRootGameplayDelta(
          request.resource.data.gameplay, resource.data.gameplay);
    }

    // New platforms require a deliberate client + rules version update.
    // Do not permit arbitrary platform IDs (e.g., path traversal/garbage).
    function supportedSettingsPlatform(platform) {
      return platform in ['windows','macos','linux','android','ios'];
    }

    function validPlatformSettingsDocument(data) {
      return data.keys().hasOnly([
          'schemaVersion','graphics','gameplay','updatedAt'
        ]) &&
        data.keys().hasAll([
          'schemaVersion','graphics','gameplay','updatedAt'
        ]) &&
        data.schemaVersion == 1 &&
        validGraphicsV2(data.graphics) &&
        validPlatformGameplayV2(data.gameplay) &&
        data.updatedAt is timestamp;
    }

    // Private canonical account document.
    //
    // The Unity account service still creates this document directly after
    // Firebase Auth registration. Client creation is therefore permitted only
    // with Atlas Board's immutable default authority values.
    //
    // A signed-in client may later change ONLY country/language. Account
    // status, membership tier, schema identity and creation time cannot be
    // escalated from the client.
    match /users/{uid} {
      allow get: if owns(uid);

      allow create: if owns(uid) &&
        validNewUser(uid);

      allow update: if owns(uid) &&
        validUserLocaleUpdate(uid);

      allow list, delete: if false;
    }

    // SEC07: Public profile projections support targeted UID lookups only.
    // Unity uses Document(uid).GetSnapshotAsync(), not a directory LIST.
    // No signed-in client may enumerate the full account registry or issue
    // collection/runQuery scans. Admin SDK server lookups remain unaffected.
    // Product note: a future friend-search directory must use a dedicated
    // callable with server-side quota, opt-in and minimal safe projections.
    match /public_profiles/{uid} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if owns(uid) &&
        validPublicProfile();

      allow update: if owns(uid) &&
        validPublicProfileUpdate();

      allow delete: if false;
    }

    // Shared preferences preserve the registration document contract.
    // Any existing platform maps in the root document are immutable legacy
    // data, read during on-device migration but never modified by new sync.
    match /preferences/{uid} {
      allow get: if owns(uid);
      allow create: if owns(uid) && validNewPreferences();
      allow update: if owns(uid) && validUpdatedPreferences();
      allow list, delete: if false;

      // One bounded document per OS / device family. Android is fully
      // supported before the Steam release; desktop/mobile do not share
      // graphics/camera settings. Feature-specific future subcollections
      // remain DENIED until their own schema and permissions are reviewed.
      match /platforms/{platform} {
        allow get: if owns(uid) && supportedSettingsPlatform(platform);
        allow create, update: if owns(uid) &&
          supportedSettingsPlatform(platform) &&
          validPlatformSettingsDocument(request.resource.data);
        allow list, delete: if false;
      }
    }

    // Everything else is backend-only by default.
    //
    // This includes wallets, ledgers, inventories, commerce, promo,
    // progression, lobby/match authority, Steam identity mappings,
    // chat/moderation state and any future collection not explicitly reviewed.
    //
    // Firebase Admin SDK / Cloud Functions bypass Firestore Security Rules and
    // continue to operate as the trusted server authority.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
