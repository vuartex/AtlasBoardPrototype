        ".read": "auth != null && (!data.exists() || root.child('roomMeta').child(data.child('lobbyId').val()).child('hostUid').val() === auth.uid || root.child('roomMembers').child(data.child('lobbyId').val()).child(auth.uid).child('active').val() === true)",
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('hostUid').val() === auth.uid && root.child('roomMeta').child(newData.child('lobbyId').val()).child('hostUid').val() === auth.uid && root.child('roomMeta').child(newData.child('lobbyId').val()).child('closed').val() === false) || (data.exists() && data.child('hostUid').val() === auth.uid && root.child('roomMeta').child(data.child('lobbyId').val()).child('hostUid').val() === auth.uid && (!newData.exists() || (newData.child('hostUid').val() === auth.uid && newData.child('matchId').val() === data.child('matchId').val() && newData.child('lobbyId').val() === data.child('lobbyId').val()))) || (data.exists() && newData.exists() && data.child('hostUid').val() !== auth.uid && root.child('roomMeta').child(data.child('lobbyId').val()).child('hostUid').val() === auth.uid && root.child('roomMeta').child(data.child('lobbyId').val()).child('activeMatchId').val() === $matchId && newData.child('hostUid').val() === auth.uid && newData.child('authorityEpoch').val() === data.child('authorityEpoch').val() + 1 && newData.child('revision').val() === data.child('revision').val() + 1 && newData.child('matchId').val() === data.child('matchId').val() && newData.child('lobbyId').val() === data.child('lobbyId').val()))",
        ".validate": "!newData.exists() || (newData.hasChildren(['matchId','lobbyId','hostUid','status','phase','revision','eventSequence','snapshotJson','seatsJson','createdAt','updatedAt','hostHeartbeatAt','authorityEpoch','networkSchemaVersion']) && newData.child('matchId').val() === $matchId && newData.child('hostUid').val() === root.child('roomMeta').child(newData.child('lobbyId').val()).child('hostUid').val() && (!data.exists() || newData.child('revision').val() >= data.child('revision').val()) && (!data.exists() || newData.child('eventSequence').val() >= data.child('eventSequence').val()) && (!data.exists() || ((newData.child('hostUid').val() === data.child('hostUid').val() && newData.child('authorityEpoch').val() === data.child('authorityEpoch').val()) || (newData.child('hostUid').val() !== data.child('hostUid').val() && newData.child('authorityEpoch').val() === data.child('authorityEpoch').val() + 1))))",
        "matchId": {
          ".validate": "newData.isString() && newData.val() === $matchId && newData.val().length >= 12 && newData.val().length <= 64"
        },
        "lobbyId": {
          ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 64"
        },
        "hostUid": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'active' || newData.val() === 'complete' || newData.val() === 'closed')"
        },
        "phase": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 64"
        },
        "turnSeatId": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "snapshotJson": {
          ".validate": "newData.isString() && newData.val().length <= 65536"
        },
        "seatsJson": {
          ".validate": "newData.isString() && newData.val().length <= 16384"
        },
        "revision": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "eventSequence": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "authorityEpoch": {
          ".validate": "newData.isNumber() && newData.val() >= 1"
        },
        "networkSchemaVersion": {
          ".validate": "newData.isNumber() && newData.val() === 1"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000 && (!data.exists() || newData.val() === data.val())"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "hostHeartbeatAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "matchPresence": {
      "$matchId": {
        ".read": "auth != null && (root.child('roomMeta').child(root.child('matchState').child($matchId).child('lobbyId').val()).child('hostUid').val() === auth.uid || root.child('roomMembers').child(root.child('matchState').child($matchId).child('lobbyId').val()).child(auth.uid).child('active').val() === true)",
        ".write": "auth != null && root.child('roomMeta').child(root.child('matchState').child($matchId).child('lobbyId').val()).child('hostUid').val() === auth.uid && !newData.exists()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('roomMembers').child(root.child('matchState').child($matchId).child('lobbyId').val()).child($uid).child('active').val() === true",
          ".validate": "!newData.exists() || newData.hasChildren(['online','lastSeenAt'])",
          "online": {
            ".validate": "newData.isBoolean()"
          },
          "lastSeenAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "publicProfiles": {
      ".read": false,
      ".write": false,
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.exists() && newData.hasChildren(['displayName','avatarId','profileFrameId','updatedAt'])",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 32"
        },
        "avatarId": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "profileFrameId": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() >= now - 300000 && newData.val() <= now + 300000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "guestNameClaims": {
      "$guestName": {
        ".read": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'anonymous' && newData.exists() && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid && newData.child('uid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['uid','displayName','createdAt']) && newData.child('uid').isString() && newData.child('uid').val() === auth.uid && newData.child('displayName').isString() && newData.child('displayName').val() === $guestName && newData.child('displayName').val().matches(/^Guest[0-9A-F]{16}$/) && newData.child('createdAt').isNumber() && ((!data.exists() && newData.child('createdAt').val() >= now - 300000 && newData.child('createdAt').val() <= now + 60000) || (data.exists() && newData.child('createdAt').val() === data.child('createdAt').val()))",
        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val() === $guestName && newData.val().matches(/^Guest[0-9A-F]{16}$/)"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
